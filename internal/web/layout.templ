package web

import "github.com/jeffgicharu/oriel/internal/assets"

// Head is the document head shared by every public page.
templ Head(p Page) {
	<meta charset="utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
	<title>{ p.FullTitle() }</title>
	<meta name="description" content={ p.Meta.Description }/>
	<meta name="robots" content="noindex, nofollow"/>
	<link rel="canonical" href={ p.Canonical() }/>
	<meta name="theme-color" content="#ecedea"/>
	<meta name="color-scheme" content="light"/>
	<meta name="format-detection" content="telephone=no"/>
	<link rel="icon" href="/favicon.ico" sizes="48x48"/>
	<link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
	<link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
	<link rel="manifest" href="/site.webmanifest"/>
	<meta property="og:site_name" content="Oriel"/>
	<meta property="og:type" content={ p.OGType() }/>
	<meta property="og:title" content={ p.FullTitle() }/>
	<meta property="og:description" content={ p.Meta.Description }/>
	<meta property="og:url" content={ p.Canonical() }/>
	<meta property="og:image" content={ p.ImageURL() }/>
	<meta property="og:image:width" content="1200"/>
	<meta property="og:image:height" content="630"/>
	<meta property="og:image:alt" content={ p.ImageAltText() }/>
	<meta property="og:locale" content="en_KE"/>
	<meta name="twitter:card" content="summary_large_image"/>
	<meta name="twitter:title" content={ p.FullTitle() }/>
	<meta name="twitter:description" content={ p.Meta.Description }/>
	<meta name="twitter:image" content={ p.ImageURL() }/>
	<meta name="twitter:image:alt" content={ p.ImageAltText() }/>
	<link rel="preload" href={ assets.URL("fonts/MonaSans.woff2") } as="font" type="font/woff2" crossorigin/>
	<link rel="stylesheet" href={ assets.URL("css/site.css") }/>
	<script type="module" src={ assets.URL("js/site.js") }></script>
	for _, module := range p.Meta.Modules {
		<script type="module" src={ assets.URL(module) }></script>
	}
	for i, data := range p.Meta.JSONLD {
		@templ.JSONScript(jsonLDID(i), data).WithType("application/ld+json")
	}
}

// Layout is the frame of every public page: header, main and footer.
templ Layout(p Page) {
	<!DOCTYPE html>
	<html lang="en-KE">
		<head>
			@Head(p)
		</head>
		<body class={ p.Meta.BodyClass }>
			<a class="skip-link" href="#main">Skip to content</a>
			@Header(p)
			<main id="main">
				{ children... }
			</main>
			@Footer(p)
		</body>
	</html>
}

templ Header(p Page) {
	<header class={ "site-header", templ.KV("site-header--over", p.Meta.HeaderOver) }>
		<div class="wrap site-header__inner">
			<a class="wordmark" href="/" aria-label="Oriel, home">
				<span class="wordmark__name">ORIEL</span>
				<span class="wordmark__place label">Riverside · Nairobi</span>
			</a>
			<nav class="site-nav" aria-label="Main">
				<ul role="list">
					for _, item := range NavItems {
						<li>
							<a href={ templ.SafeURL(item.Href) } { current(p.Meta.Nav == item.Key)... }>{ item.Label }</a>
						</li>
					}
				</ul>
			</nav>
			<a class="btn btn--cobalt btn--small site-header__cta" href="/viewings/new">Book a viewing</a>
			<button class="menu-button" type="button" aria-expanded="false" aria-controls="menu-sheet" data-menu-button>
				<span data-menu-label>Menu</span>
				<span class="menu-button__lines" aria-hidden="true"></span>
			</button>
		</div>
	</header>
	<div class="menu-sheet" id="menu-sheet">
		<nav aria-label="Main">
			<ol role="list">
				for _, item := range NavItems {
					<li>
						<a href={ templ.SafeURL(item.Href) } { current(p.Meta.Nav == item.Key)... }>
							<span>{ item.Label }</span>
							<span class="label">{ item.Sheet }</span>
						</a>
					</li>
				}
			</ol>
		</nav>
		<div class="menu-sheet__foot">
			<a class="btn btn--cobalt btn--wide" href="/viewings/new">Book a viewing</a>
			<a class="btn btn--line btn--wide" href="/enquire">Ask a question</a>
			<p class="label muted">Sales suite open Tuesday to Sunday, 10:00 to 17:00</p>
		</div>
	</div>
}

templ Footer(p Page) {
	<footer class="site-footer">
		<div class="wrap">
			if !p.Meta.Quiet {
				<div class="footer-cta">
					<h2 class="h2">See the light for yourself.</h2>
					<div class="hero__actions">
						<a class="btn btn--cobalt" href="/viewings/new">Book a viewing @Arrow()</a>
						<a class="btn btn--line" href="/residences">Find a home</a>
					</div>
				</div>
			}
			<div class="footer-cols">
				<div class="footer-col footer-col--visit">
					<span class="label">Sales suite</span>
					<p>On site at Oriel, Riverside, Nairobi. Open Tuesday to Sunday, 10:00 to 17:00, by appointment.</p>
					<a class="link-arrow" href="/location">Getting here @Arrow()</a>
				</div>
				<div class="footer-col">
					<span class="label">The building</span>
					<a href="/residences">Residences</a>
					<a href="/explore">Explore in 3D</a>
					<a href="/building">Amenities and specification</a>
					<a href="/progress">Construction progress</a>
				</div>
				<div class="footer-col">
					<span class="label">Buying</span>
					<a href="/buying">Buying off-plan</a>
					<a href="/buying#payment-plans">Payment plans</a>
					<a href="/price-list.pdf">Price list (PDF)</a>
					<a href="/viewings/new">Book a viewing</a>
				</div>
				<div class="footer-col">
					<span class="label">Oriel</span>
					<a href="/enquire">Ask a question</a>
					<a href="/privacy">Privacy</a>
					<a href="/terms">Terms</a>
					<a href="/desk">Sales desk</a>
				</div>
			</div>
			<div class="footer-mark" aria-hidden="true">ORIEL</div>
			<dl class="title-block">
				<div><dt class="label">Project</dt><dd>Oriel, Riverside, Nairobi</dd></div>
				<div><dt class="label">Sheet</dt><dd>{ p.SheetNumber() } · { p.SheetName() }</dd></div>
				<div><dt class="label">Drawn</dt><dd>{ p.Drawn() }</dd></div>
				<div><dt class="label">Rev.</dt><dd>{ p.Revision() }</dd></div>
				<div><dt class="label">©</dt><dd>{ p.Site.Now.In(Nairobi).Format("2006") } { CompanyName }</dd></div>
			</dl>
		</div>
	</footer>
}

// Arrow is the long arrow used on links and buttons.
templ Arrow() {
	<svg class="arrow" viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
		<path d="M0 5h16.5M12.5 1l4 4-4 4"></path>
	</svg>
}
